<resources>
    <!-- JustCam: Material 3 (dark). All legacy custom attrs map onto M3 colour roles so
         dynamic colour / AMOLED variants work without touching every layout. -->
    <style name="Base.Theme.FadCam" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/jc_primary</item>
        <item name="colorOnPrimary">@color/jc_on_primary</item>
        <item name="colorPrimaryContainer">@color/jc_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/jc_on_primary_container</item>
        <item name="colorSecondary">@color/jc_secondary</item>
        <item name="colorOnSecondary">@color/jc_on_secondary</item>
        <item name="colorSecondaryContainer">@color/jc_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/jc_on_secondary_container</item>
        <item name="colorTertiary">@color/jc_tertiary</item>
        <item name="colorOnTertiary">@color/jc_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/jc_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/jc_on_tertiary_container</item>
        <item name="colorError">@color/jc_error</item>
        <item name="colorSurface">@color/jc_surface</item>
        <item name="colorOnSurface">@color/jc_on_surface</item>
        <item name="colorSurfaceVariant">@color/jc_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/jc_on_surface_variant</item>
        <item name="colorOutline">@color/jc_outline</item>
        <item name="colorOutlineVariant">@color/jc_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/jc_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/jc_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/jc_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/jc_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/jc_surface_container_highest</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="colorOnBackground">?attr/colorOnSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <!-- Legacy attrs used by existing layouts, mapped to M3 roles -->
        <item name="backgroundColor">?attr/colorSurface</item>
        <item name="colorTopBar">?attr/colorSurface</item>
        <item name="colorStatusBar">?attr/colorSurface</item>
        <item name="colorBottomNav">?attr/colorSurfaceContainer</item>
        <item name="colorHeading">?attr/colorPrimary</item>
        <item name="sectionHeaderColor">?attr/colorPrimary</item>
        <item name="colorButton">?attr/colorPrimary</item>
        <item name="colorToggle">?attr/colorPrimary</item>
        <item name="colorSwitchTrack">?attr/colorSurfaceContainerHighest</item>
        <item name="colorDialog">?attr/colorSurfaceContainerHigh</item>
        <item name="pickerGradientStart">?attr/colorSurfaceContainerHigh</item>
        <item name="pickerGradientMid">?attr/colorSurfaceContainer</item>
        <item name="pickerGradientEnd">?attr/colorSurface</item>
        <item name="pickerTextPrimary">?attr/colorOnSurface</item>
        <item name="pickerTextSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="pickerButtonBackground">?attr/colorPrimary</item>
        <item name="pickerButtonText">?attr/colorOnPrimary</item>
        <item name="pickerIconTint">?attr/colorPrimary</item>
        <item name="pickerSliderActive">?attr/colorPrimary</item>
        <item name="pickerSliderInactive">?attr/colorSurfaceContainerHighest</item>
        <item name="homeRailBgStart">?attr/colorSurface</item>
        <item name="homeRailBgEnd">?attr/colorSurface</item>
        <item name="homeRailCardSurface">?attr/colorSurfaceContainer</item>
        <item name="homeRailCardBorder">?attr/colorOutlineVariant</item>
        <item name="homeRailCardStroke">?attr/colorOutlineVariant</item>
        <item name="homeRailTileSurface">?attr/colorSurfaceContainerHigh</item>
        <item name="homeRailSegmentedSurface">?attr/colorSurfaceContainer</item>
        <item name="homeRailSegmentedBorder">?attr/colorOutlineVariant</item>
        <item name="homeRailSegmentActive">?attr/colorPrimaryContainer</item>
        <item name="homeRailSegmentActiveText">?attr/colorOnPrimaryContainer</item>
        <item name="homeRailTextPrimary">?attr/colorOnSurface</item>
        <item name="homeRailTextSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="homeRailAccent">?attr/colorPrimary</item>
    </style>

    <!-- True-black variant for OLED screens (no dynamic colour) -->
    <style name="Theme.FadCam.Amoled" parent="Base.Theme.FadCam">
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0F0E</item>
        <item name="colorSurfaceContainer">#101514</item>
        <item name="colorSurfaceContainerHigh">#1A201F</item>
        <item name="colorSurfaceContainerHighest">#242A29</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Base application theme. -->

    <!-- Splash theme leveraging AndroidX SplashScreen attributes (Fix Start Theme.FadCam.Splash) -->
    <style name="Theme.FadCam.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Solid dark background -->
        <item name="android:windowBackground">@color/black</item>
        <!-- SplashScreen API attrs -->
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fadseclab_flag</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="postSplashScreenTheme">@style/Base.Theme.FadCam</item>
    </style>
    <!-- Splash theme end (Fix End Theme.FadCam.Splash) -->


    <style name="Theme.FadCam.AmoledCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/amoled_surface</item>
    </style>

    <style name="Theme.FadCam.AmoledBottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@color/amoled_background</item>
        <item name="itemIconTint">@color/amoled_text_primary</item>
        <item name="itemTextColor">@color/amoled_text_primary</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="labelVisibilityMode">selected</item>
        <item name="itemPaddingTop">0dp</item>
        <item name="itemPaddingBottom">0dp</item>
    </style>

    <style name="ThemeOverlay.FadCam.Amoled.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:textColorPrimary">@color/amoled_text_primary</item>
        <item name="android:textColorSecondary">@color/amoled_text_primary</item>
