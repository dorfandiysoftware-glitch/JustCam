    <!-- Universal switch style that adapts to theme colors -->
    <style name="Widget.FadCam.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
