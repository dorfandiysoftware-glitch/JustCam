<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_sidebar_root_scroll"
    android:layout_width="320dp"
    android:layout_height="match_parent"
    android:background="@drawable/home_sidesheet_gradient_bg_dynamic"
    android:clipToOutline="true"
    android:outlineProvider="background"
    android:fillViewport="true"
    android:scrollbars="vertical">

<LinearLayout
    android:id="@+id/home_sidebar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

        <!-- Header with close button and title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:paddingStart="6dp" android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/home_sidebar_close_btn"
                android:layout_width="14dp" android:layout_height="14dp"
                android:layout_marginEnd="0dp"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="?attr/pickerTextSecondary"
                android:clickable="true" android:focusable="true"/>

            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="4dp"
                android:text="@string/home_options_title"
                android:textColor="?attr/pickerTextPrimary"
                android:textStyle="bold" android:textSize="17sp"/>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp" app:dividerColor="#262626"/>

        <!-- Profiles placeholder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_group_card_bg"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true">

        <LinearLayout
            android:id="@+id/row_profiles"
            style="@style/SettingsGroupRow"
            android:clickable="true" android:focusable="true"
            android:minHeight="56dp">

            <TextView android:layout_width="24dp" android:layout_height="24dp"
                android:layout_marginEnd="16dp" android:fontFamily="@font/materialicons"
                android:text="video_library" android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" android:gravity="center"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/nav_records" android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/sidebar_records_desc"
                    android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp"
                    android:layout_marginStart="6dp" android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>

        <!-- Group: Update Available -->
        <LinearLayout
            android:id="@+id/update_available_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/settings_group_card_bg"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/update_group_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sidebar_update_available"
                android:textColor="?attr/colorAccent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <!-- Stable Card -->
            <FrameLayout
                android:id="@+id/card_update_stable"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:background="@drawable/card_bg_stable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="8dp"
                
                
                
                
                
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp">

                    <TextView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="10dp" android:fontFamily="@font/materialicons"
                        android:text="verified" android:textColor="#FFFFFF" android:textSize="18sp"
                        android:gravity="center"/>

<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sidebar_stable_release" android:textColor="#FFFFFF"
                                android:textStyle="bold" android:textSize="12sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="16dp"
                                android:layout_marginStart="6dp" android:paddingHorizontal="6dp"
                                android:text="@string/badge_new" android:textColor="#FFFFFF"
                                android:textSize="8sp" android:textStyle="bold"
                                android:gravity="center"
                                android:background="@drawable/bg_badge_stable"/>
                        </LinearLayout>
                          <TextView android:id="@+id/tv_stable_version" android:layout_width="wrap_content"
                             android:layout_height="wrap_content" android:text="v--  >>  v--"
                             android:textColor="#66BB6A" android:textSize="11sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#FFFFFF" android:alpha="0.5"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Beta Card -->
            <FrameLayout
                android:id="@+id/card_update_beta"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:background="@drawable/card_bg_beta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="8dp"
                
                
                
                
                
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp">

                    <TextView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="10dp" android:fontFamily="@font/materialicons"
                        android:text="science" android:textColor="#FFFFFF" android:textSize="18sp"
                        android:gravity="center"/>

<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sidebar_beta_release" android:textColor="#FFFFFF"
                                android:textStyle="bold" android:textSize="12sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="16dp"
                                android:layout_marginStart="6dp" android:paddingHorizontal="6dp"
                                android:text="@string/badge_new" android:textColor="#FFFFFF"
                                android:textSize="8sp" android:textStyle="bold"
                                android:gravity="center"
                                android:background="@drawable/bg_badge_beta"/>
                        </LinearLayout>
                          <TextView android:id="@+id/tv_beta_version" android:layout_width="wrap_content"
                             android:layout_height="wrap_content" android:text="v--  >>  v--"
                             android:textColor="#BA68C8" android:textSize="11sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#FFFFFF" android:alpha="0.5"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Pro Card -->
            <FrameLayout
                android:id="@+id/card_update_pro"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:background="@drawable/card_bg_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="8dp"
                
                
                
                
                
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp">

                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_crown" android:tint="#FFFFFF"
                        android:scaleType="centerInside"/>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sidebar_fadcam_pro" android:textColor="#FFFFFF"
                                android:textStyle="bold" android:textSize="12sp"/>
                             <TextView android:layout_width="wrap_content" android:layout_height="16dp"
                                android:layout_marginStart="6dp" android:paddingHorizontal="6dp"
                                android:text="@string/badge_new" android:textColor="#1A1A1A"
                                android:textSize="8sp" android:textStyle="bold"
                                android:gravity="center"
                                android:background="@drawable/bg_badge_pro"/>
                        </LinearLayout>
                          <TextView android:id="@+id/tv_pro_version" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="v--  >>  v--"
                            android:textColor="#FFFFFF" android:textSize="11sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <ImageView android:layout_width="14dp" android:layout_height="14dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="#FFFFFF" android:alpha="0.5"/>
        </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Group: Display Settings -->
        <TextView
            android:id="@+id/display_group_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/display_settings_title"
            android:textColor="?attr/colorOnSurface"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textStyle="bold"
            android:textAlignment="viewStart"/>

        <!-- Display settings group card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"


            android:background="@drawable/settings_group_card_bg">

            <!-- Preview toggle row -->
            <LinearLayout
                android:id="@+id/row_preview_toggle"
                style="@style/SettingsGroupRow"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Preview icon using Material Icons ligature -->
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:text="visibility"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:gravity="center" />

                <!-- Title and subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_preview_toggle_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_enabled"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textAlignment="viewStart"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_preview_toggle_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_disabled"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:textAlignment="viewStart" />
                </LinearLayout>

                <!-- AvatarToggleView — consistent with all other toggle rows -->
                <com.fadcam.ui.AvatarToggleView
                    android:id="@+id/iv_preview_toggle"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="0dp"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:dividerColor="#262626"/>

            <LinearLayout
                android:id="@+id/row_preview_quick_actions_toggle"
                style="@style/SettingsGroupRow"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:text="widgets"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_preview_quick_actions_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_quick_actions_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textAlignment="viewStart"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_preview_quick_actions_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_quick_actions_sub"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:textAlignment="viewStart" />
                </LinearLayout>

                <com.fadcam.ui.AvatarToggleView
                    android:id="@+id/switch_preview_quick_actions_toggle"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="0dp"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:dividerColor="#262626"/>

            <!-- Grid lines (rule of thirds) row -->
            <LinearLayout
                android:id="@+id/row_grid_lines"
                style="@style/SettingsGroupRow"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:text="grid_on"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_grid_lines_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/grid_lines_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textAlignment="viewStart"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_grid_lines_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/grid_lines_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:textAlignment="viewStart" />
                </LinearLayout>

                <com.fadcam.ui.AvatarToggleView
                    android:id="@+id/switch_grid_lines"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="0dp"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

        </LinearLayout>

        <!-- Group: Help & Support -->
        <TextView
            android:id="@+id/help_group_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_section"
            android:textColor="?attr/colorOnSurface"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:textStyle="bold"
            android:textAlignment="viewStart"/>

        <!-- Help group card wrapper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"


            android:background="@drawable/settings_group_card_bg">

            <!-- What's New row -->
            <LinearLayout
                android:id="@+id/row_whats_new"
                style="@style/SettingsGroupRow"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- What's New icon using Material Icons ligature -->
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:text="new_releases"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:gravity="center" />

                <!-- What's New title and subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/whats_new_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:textAlignment="viewStart"
                            android:layout_marginBottom="2dp" />

                        <!-- What's New Badge -->
                        <TextView
                            android:id="@+id/badge_whats_new"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:paddingHorizontal="6dp"
                            android:text="@string/badge_new"
                            android:textColor="@android:color/white"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_coming_soon_badge"
                            android:layout_marginStart="0dp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/whats_new_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:textAlignment="viewStart" />

                </LinearLayout>

                <!-- Arrow -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- Divider between rows -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:dividerColor="#262626"/>

            <!-- Tips row -->
            <LinearLayout
                android:id="@+id/row_tips"
                style="@style/SettingsGroupRow"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Tips icon using Material Icons ligature -->
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:text="lightbulb"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:gravity="center" />

                <!-- Tips title and subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_gravity="center_vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tips_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textAlignment="viewStart"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tips_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:textAlignment="viewStart" />

                </LinearLayout>

                <!-- Arrow -->
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </LinearLayout>

        <!-- Spacer to push branding footer to bottom -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Branding footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <!-- Discord row -->
            <LinearLayout
                android:id="@+id/row_discord_branding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="0dp"
                    android:src="@drawable/ic_discord" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_sidebar_discord"
                    android:textColor="?attr/pickerTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Copyright -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_sidebar_copyright"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

</LinearLayout>

</ScrollView>
