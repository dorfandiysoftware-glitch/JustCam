<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Fixed Header (no scroll) -->
    <LinearLayout
        android:id="@+id/fixed_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/header_settings_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/setup_back"
            android:src="@drawable/ic_arrow_right"
            android:rotation="180"
            android:padding="10dp"
            app:tint="?attr/colorOnSurface" />
        <TextView
            android:id="@+id/header_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"/>
        <!-- Mode selector button -->
        <LinearLayout
            android:id="@+id/mode_selector_btn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/mode_selector_bg"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true">
            <FrameLayout
                android:id="@+id/mode_selector_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp">
                <TextView
                    android:id="@+id/mode_selector_icon_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/materialicons"
                    android:text="apps"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="visible"/>
                <ImageView
                    android:id="@+id/mode_selector_icon_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/screen_recorder"
                    android:tint="?attr/colorOnSecondaryContainer"
                    android:scaleType="centerInside"
                    android:visibility="gone"/>
            </FrameLayout>
            <TextView
                android:id="@+id/mode_selector_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_all"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="11sp"
                android:textStyle="bold"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_arrow_right"
                android:tint="?attr/colorOnSecondaryContainer"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/fixed_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="76dp"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:focusable="false">

        <!-- README Section Header (new) -->

        <!-- README Group Card -->

        <!-- Recording Quick Access Section Header -->
        <TextView
            android:id="@+id/header_recording_quick_access"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/recording_quick_access"
            android:textColor="?attr/sectionHeaderColor"
            android:textStyle="bold" />

        <!-- Recording Quick Access Group Card -->
        <LinearLayout
            android:id="@+id/group_card_quick_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_group_card_bg"

>

            <!-- Video (from general, moved to quick access) -->
            <LinearLayout
                android:id="@+id/group_video_quick"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusDown="@+id/group_audio_quick">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/play_button_rounded"
                    android:padding="2dp"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_video_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_video_bitrate_title"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Audio (from general, moved to quick access) -->
            <LinearLayout
                android:id="@+id/group_audio_quick"
                style="@style/SettingsGroupRow"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/group_video_quick"
                android:nextFocusDown="@+id/group_watermark_quick">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_audio"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_audio_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/button_audio_settings"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Watermark (from general, moved to quick access) with NEW badge -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                
                <LinearLayout
                    android:id="@+id/group_watermark_quick"
                    style="@style/SettingsGroupRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/group_audio_quick">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_watermark"
                        android:tint="?attr/colorPrimary"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_watermark_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_watermark_subtitle"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
                
                <!-- Watermark NEW badge (top-right) -->
                <TextView
                    android:id="@+id/watermark_new_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_coming_soon_badge"
                    android:textColor="@android:color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/new_badge_background"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="20dp" />
            </FrameLayout>
            <View style="@style/SettingsDivider" />

            <!-- Screen Recording Row -->
            <LinearLayout
                android:id="@+id/group_screen_recording"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/screen_recorder"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_rec_settings_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_rec_settings_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
        </LinearLayout>

        <!-- General Section Header -->
        <TextView
            android:id="@+id/header_general"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/general"
            android:textColor="?attr/sectionHeaderColor"
            android:textStyle="bold" />

        <!-- General Group Card -->
        <LinearLayout
            android:id="@+id/group_card_general"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_group_card_bg"

>

            <!-- Appearance Row -->
            <LinearLayout
                android:id="@+id/group_appearance"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_theme"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_theme_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_option_theme"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Video Player Settings (Playback & Quick Speed) -->
            <LinearLayout
                android:id="@+id/group_video_player_settings"
                style="@style/SettingsGroupRow">
                <!-- Use Material Icons ligature per policy -->
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center"
                    android:text="speed"
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="@font/materialicons" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/video_player_settings_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/video_player_settings_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Storage -->
            <LinearLayout
                android:id="@+id/group_storage"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_custom_location"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/storage_location_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/storage_location_description"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Notifications -->
            <LinearLayout
                android:id="@+id/group_notifications"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_info"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notifications_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notifications_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />


            <!-- Security -->
            <LinearLayout
                android:id="@+id/group_security"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_lock"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_security_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_applock_title"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />


            <!-- Shortcuts (moved under General) -->
            <LinearLayout
                android:id="@+id/group_widgets"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_home"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shortcuts_widgets_screen_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shortcuts_pin_to_home"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <!-- Close General Group Card -->
        </LinearLayout>

        <!-- Advanced Section Header -->
        <TextView
            android:id="@+id/header_advanced"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_advanced_title"
            android:textColor="?attr/sectionHeaderColor"
            android:textStyle="bold" />

        <!-- Advanced Group Card -->
        <LinearLayout
            android:id="@+id/group_card_advanced_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_group_card_bg"

>

            <LinearLayout
                android:id="@+id/row_haptics_settings"
                style="@style/SettingsGroupRow">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/materialicons"
                    android:gravity="center"
                    android:text="vibration"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="22sp"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_haptics_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_haptics_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>

            <View style="@style/SettingsDivider" />


            <View style="@style/SettingsDivider" />


            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/group_automation"
                style="@style/SettingsGroupRow">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_settings"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/automation_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/automation_row_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>

            <View style="@style/SettingsDivider" />


            <View style="@style/SettingsDivider" />


            <View style="@style/SettingsDivider" />


            <View style="@style/SettingsDivider" />


        </LinearLayout>

        <!-- About Section Header -->
        <TextView
            android:id="@+id/header_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_section_app"
            android:textColor="?attr/sectionHeaderColor"
            android:textStyle="bold" />

        <!-- About Group Card -->
        <LinearLayout
            android:id="@+id/group_card_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/settings_group_card_bg"

>

            <!-- Onboarding Row -->
            <LinearLayout
                android:id="@+id/group_onboarding"
                style="@style/SettingsGroupRow"
                >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_info"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_onboarding_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/value_onboarding"
                        android:text="-"
                        android:layout_marginEnd="12dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Auto Update Row -->
            <View style="@style/SettingsDivider" />

            <!-- Debug Logging Row -->
            <LinearLayout
                android:id="@+id/group_debug_logging"
                style="@style/SettingsGroupRow"
                >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_debug"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_debug_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:id="@+id/value_debug_logging"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:layout_marginEnd="12dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Import / Export Preferences Row -->
            <LinearLayout
                android:id="@+id/group_prefs_backup"
                style="@style/SettingsGroupRow"
                >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_content_copy"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prefs_import_export_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prefs_import_export_subtitle"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <LinearLayout
                android:id="@+id/group_about"
                style="@style/SettingsGroupRow"
                >
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_info"
                    android:tint="?attr/colorPrimary"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_about"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_version_update_licenses"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
            <View style="@style/SettingsDivider" />

            <!-- Review Row (new) -->

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Trash Section — standalone                                       -->
        <!-- ═══════════════════════════════════════════════════════════ -->

        <LinearLayout
            android:id="@+id/section_trash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trash_settings_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <LinearLayout
                    android:id="@+id/group_trash_hide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trash_settings_hide_button"
                        android:textColor="#CC6666"
                        android:textSize="11sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="?"
                        android:textColor="#CC6666"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_group_card_bg">

                <LinearLayout
                    android:id="@+id/group_trash"
                    style="@style/SettingsGroupRow">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_delete"
                        android:tint="?attr/colorPrimary"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trash_settings_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trash_settings_subtitle"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_arrow_right"
                        android:tint="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Footer text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="6dp"
                android:text="@string/trash_settings_info"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"/>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- Tutorial Videos Section                                      -->
        <!-- ═══════════════════════════════════════════════════════════ -->


        <!-- Tutorial content card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/settings_group_card_bg"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">


        <!-- Subscribe CTA -->

        </LinearLayout>
        <!-- End tutorial content card -->

        <!-- Footer subtitle -->

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- App promo section                                           -->
        <!-- ═══════════════════════════════════════════════════════════ -->



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
